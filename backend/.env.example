# Ollama Local LLM Configuration (Enabled by default)
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Hindsight (Vectorize) Configuration
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.vectorize.io/v1/hindsight
HINDSIGHT_PROJECT_ID=companybrain_novastack

# Cloud LLM Fallbacks (Optional)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server Configuration
PORT=8000
DEBUG=True
